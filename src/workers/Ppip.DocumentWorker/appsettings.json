{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "Ppip": {
    "Mongo": { "ConnectionString": "", "DocumentsDatabaseName": "documents", "KnowledgeDatabaseName": "knowledge" },
    "RabbitMq": { "Host": "", "Username": "", "Password": "" },
    "MinIo": { "Endpoint": "", "AccessKey": "", "SecretKey": "" },
    "Qdrant": { "Endpoint": "", "ApiKey": "", "CollectionName": "chunks_v1" },
    "Ollama": { "Endpoint": "" },
    "Knowledge": {
      "Embeddings": { "Provider": "Mock", "ModelVersion": "nomic-embed-text", "Dimension": 768 },
      "Indexing": { "Source": "chilecompra", "IsDemoData": false, "Producer": "document-worker@1.0.0" }
    },
    "Documents": {
      "AllowedUrlPatterns": ["*.mercadopublico.cl"],
      "AllowedContentTypes": ["application/pdf"],
      "MaxSizeBytes": 52428800,
      "Bucket": "chilecompra",
      "Producer": "document-worker@1.0.0",
      "Processing": {
        "TextualDensityThreshold": 0.005,
        "ScannedDensityThreshold": 0.001,
        "TargetChunkTokens": 384,
        "MaxChunkTokens": 512,
        "ChunkOverlapTokens": 30,
        "Producer": "document-worker@1.0.0"
      }
    },
    "Ocr": {
      "Provider": "Mock",
      "TessDataPath": "./tessdata",
      "Languages": "spa+eng"
    },
    "Otel": { "Endpoint": "" }
  }
}
