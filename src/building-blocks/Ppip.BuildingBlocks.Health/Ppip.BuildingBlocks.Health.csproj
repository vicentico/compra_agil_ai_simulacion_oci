<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Ppip.BuildingBlocks.Health</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Provee Microsoft.Extensions.Diagnostics.HealthChecks (HealthCheckResult,
         IHealthCheck): desde .NET Core 3+ solo se distribuye en el shared
         framework de ASP.NET Core, no como paquete NuGet independiente. Fix de
         un defecto pre-existente de FASE 1 (nunca se había compilado en un
         entorno con SDK real, ver docs/ROADMAP.md nota de cierre de FASE 1). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Versión flotante intencional para el esqueleto de FASE 1: se fija una
         versión exacta vía Central Package Management al implementar lógica
         real de dominio (FASE 4+). Ver docs/ROADMAP.md. -->
    <PackageReference Include="MongoDB.Driver" Version="3.*" />
    <PackageReference Include="RabbitMQ.Client" Version="7.*" />
    <PackageReference Include="StackExchange.Redis" Version="2.*" />
  </ItemGroup>
</Project>
