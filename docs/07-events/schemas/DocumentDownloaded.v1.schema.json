{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppip.local/schemas/DocumentDownloaded.v1.schema.json",
  "title": "DocumentDownloaded.v1",
  "description": "docs/07-events/00-event-conventions.md catalogo. Productor: Ppip.DocumentIntelligence.Application.DocumentEventPublisher (FASE 7).",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "DocumentDownloaded" },
        "version": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["documentId", "compraAgilId", "versionId", "sha256", "storageRef", "sizeBytes"],
          "properties": {
            "documentId": { "type": "string", "minLength": 1 },
            "compraAgilId": { "type": "string", "minLength": 1 },
            "versionId": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "storageRef": {
              "type": "object",
              "required": ["bucket", "key"],
              "properties": {
                "bucket": { "type": "string", "minLength": 1 },
                "key": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "sizeBytes": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
