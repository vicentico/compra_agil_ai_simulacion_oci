# ==========================================================================
# PPIP — Variables de entorno (FASE 1: Docker infrastructure)
# Copiar a `.env` en esta misma carpeta y completar. NUNCA commitear `.env`
# con secretos reales (NFR-008, ADR-010, docs/12-security/01).
# ==========================================================================

# --- General ---
PPIP_DOMAIN=ppip.localhost
COMPOSE_PROJECT_NAME=ppip

# --- MongoDB (ADR-002) ---
MONGO_ROOT_USER=ppip_root
MONGO_ROOT_PASSWORD=changeme_local_only
MONGO_PORT=27017

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ (ADR-003) ---
RABBITMQ_USER=ppip
RABBITMQ_PASSWORD=changeme_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO (ADR-004) ---
MINIO_ROOT_USER=ppip_minio
MINIO_ROOT_PASSWORD=changeme_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Qdrant (ADR-005) ---
QDRANT_API_KEY=changeme_local_only
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Keycloak (ADR-010) ---
# Modo start-dev (almacenamiento dev-file) para el POC local — NO usar en
# producción/OCI. Ver decisión documentada en docs/04-architecture/04-deployment-diagram.md.
KEYCLOAK_ADMIN_USER=ppip_admin
KEYCLOAK_ADMIN_PASSWORD=changeme_local_only
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=ppip

# --- Ollama (ADR-007) ---
OLLAMA_PORT=11434

# --- Traefik (ADR-009) ---
TRAEFIK_DASHBOARD_PORT=8080

# --- Platform API / Workers (esqueletos FASE 1) ---
PLATFORM_API_PORT=5080
CORS_ALLOWED_ORIGINS=http://ppip.localhost,http://app.ppip.localhost

# --- Frontend ---
FRONTEND_PORT=4200
